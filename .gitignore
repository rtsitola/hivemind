# HiveMind — Fichiers à ne pas versionner

# Base de données consolidée (générée localement, jamais sync)
*.db
*.db-wal
*.db-shm
*.db-journal

# Fichiers lock
*.lock

# Données de test (memory/ est local, généré par les tests)
memory/

# Clés API — JAMAIS dans Git
.env

# Python
__pycache__/
*.pyc
*.pyo

# Fichiers temporaires
*.tmp
*.bak
.DS_Store
Thumbs.db

# Fichiers de test générés
/tmp/
test_clusters/
